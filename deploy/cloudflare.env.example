# Cloudflare Pages > Settings > Variables and Secrets (all values below are public).
# Build command: node scripts/build.mjs
# Build output directory: dist
NODE_VERSION=24
MEMORY_MODE=supabase
MEMORY_TARGET=cloudflare
MEMORY_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
MEMORY_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY
MEMORY_TURNSTILE_SITE_KEY=REPLACE_WITH_PUBLIC_SITE_KEY
# Leave false until native Auth and database/storage permission tests pass.
MEMORY_AUTH_READY=false
# Never add a password, service_role/secret key, DB password or CAPTCHA secret.
