PUBLIC_ORIGIN=https://memory.example.com
MEMORY_SPACE=spaces/together
# Keep loopback when a host HTTPS proxy terminates TLS.
MEMORY_LISTEN=127.0.0.1
# These are account names, never passwords. CLI initialization must use the same names.
MEMORY_MEMBER_ONE_USERNAME=xbl
MEMORY_MEMBER_TWO_USERNAME=ll
MEMORY_ADMIN_USERNAME=memory-admin
# Add the public widget key and private verification key locally. Never commit the private key.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
